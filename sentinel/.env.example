# Required: Groq API key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Model routing (defaults shown; catalog verified 2026-08)
# LLM_STRONG_MODEL=openai/gpt-oss-120b
# LLM_FAST_MODEL=openai/gpt-oss-20b
# LLM_TIMEOUT_S=30
# LLM_MAX_RETRIES=2
# LLM_VERIFICATION_SAMPLES=3
# DAILY_TOKEN_BUDGET=12000

# Storage (SQLite default; Postgres URL for production)
# DATABASE_URL=sqlite:///./data/sentinel.db
CHROMA_PERSIST_DIR=./data/chromadb

# Security: comma-separated accepted keys. REQUIRED when APP_ENV=production.
APP_ENV=development
API_KEYS=
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:8501

LOG_LEVEL=INFO
LOG_JSON=false
